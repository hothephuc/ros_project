<?xml version="1.0"?>
<!--
  An 8-joint biped, about 0.8 m tall: torso + two legs (hip roll, hip pitch, knee, ankle pitch).

  xacro args:
    fixed:=true        bolt the torso to the world 1 m up, so the legs hang in the air
    sim:=true          add the ros2_control block and the Gazebo plugin
    controllers:=PATH  controllers YAML for the Gazebo plugin (the launch file fills it in)
-->
<robot name="biped" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="fixed" default="false"/>
  <xacro:arg name="sim" default="false"/>
  <xacro:arg name="controllers" default=""/>

  <xacro:property name="torso_x" value="0.15"/>
  <xacro:property name="torso_y" value="0.25"/>
  <xacro:property name="torso_z" value="0.30"/>

  <xacro:include filename="inertia.xacro"/>
  <xacro:include filename="leg.xacro"/>

  <material name="torso_orange"><color rgba="0.95 0.55 0.15 1"/></material>
  <material name="limb_blue"><color rgba="0.25 0.45 0.85 1"/></material>
  <material name="joint_grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="foot_dark"><color rgba="0.2 0.2 0.2 1"/></material>

  <xacro:if value="$(arg fixed)">
    <link name="world"/>
    <joint name="world_to_torso" type="fixed">
      <parent link="world"/>
      <child link="torso"/>
      <origin xyz="0 0 1.0"/>
    </joint>
  </xacro:if>

  <link name="torso">
    <visual>
      <geometry><box size="${torso_x} ${torso_y} ${torso_z}"/></geometry>
      <material name="torso_orange"/>
    </visual>
    <collision>
      <geometry><box size="${torso_x} ${torso_y} ${torso_z}"/></geometry>
    </collision>
    <xacro:box_inertia m="8.0" x="${torso_x}" y="${torso_y}" z="${torso_z}"><origin xyz="0 0 0"/></xacro:box_inertia>
  </link>

  <xacro:leg side="left" reflect="1"/>
  <xacro:leg side="right" reflect="-1"/>

  <xacro:if value="$(arg sim)">
    <xacro:include filename="biped.ros2_control.xacro"/>
    <xacro:biped_ros2_control controllers="$(arg controllers)"/>
  </xacro:if>

</robot>
