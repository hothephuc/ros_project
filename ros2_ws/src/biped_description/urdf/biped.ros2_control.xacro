<?xml version="1.0"?>
<!-- ros2_control: a position command interface for every joint, backed by Gazebo through gz_ros2_control. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="position_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="biped_ros2_control" params="controllers">
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:position_joint name="left_hip_roll"/>
      <xacro:position_joint name="left_hip_pitch"/>
      <xacro:position_joint name="left_knee"/>
      <xacro:position_joint name="left_ankle_pitch"/>
      <xacro:position_joint name="right_hip_roll"/>
      <xacro:position_joint name="right_hip_pitch"/>
      <xacro:position_joint name="right_knee"/>
      <xacro:position_joint name="right_ankle_pitch"/>
    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers}</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>

</robot>
